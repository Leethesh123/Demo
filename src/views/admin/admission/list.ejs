<script>
// Helper function to get status badge class
function getStatusBadgeClass(status) {
  switch(status.toLowerCase()) {
    case 'pending':
      return 'bg-warning';
    case 'approved':
      return 'bg-success';
    case 'rejected':
      return 'bg-danger';
    default:
      return 'bg-secondary';
  }
}

// Search functionality
document.getElementById('searchInput').addEventListener('input', function(e) {
  const searchTerm = e.target.value.toLowerCase();
  const rows = document.querySelectorAll('tbody tr');
  
  rows.forEach(row => {
    const text = row.textContent.toLowerCase();
    row.style.display = text.includes(searchTerm) ? '' : 'none';
  });
});

// Filter functions
function filterByStatus(status) {
  const rows = document.querySelectorAll('tbody tr');
  rows.forEach(row => {
    if (status === 'all') {
      row.style.display = '';
    } else {
      const statusCell = row.querySelector('td:nth-child(5)');
      row.style.display = statusCell.textContent.trim().toLowerCase() === status ? '' : 'none';
    }
  });
}

function applyFilters() {
  const grade = document.getElementById('gradeFilter').value;
  const year = document.getElementById('yearFilter').value;
  
  // Implement filter logic here
  console.log('Applying filters:', { grade, year });
}

// Action functions
function viewDetails(id) {
  window.location.href = `/admin/admission/view/${id}`;
}

function editAdmission(id) {
  window.location.href = `/admin/admission/edit/${id}`;
}

function deleteAdmission(id) {
  if (confirm('Are you sure you want to delete this admission?')) {
    // Implement delete logic here
    console.log('Deleting admission:', id);
  }
}

function exportToExcel() {
  // Implement export to Excel logic here
  console.log('Exporting to Excel');
}

function printList() {
  window.print();
}

function changePage(page) {
  if (page >= 1 && page <= totalPages) {
    window.location.href = `/admin/admission/list?page=${page}`;
  }
}
</script>

