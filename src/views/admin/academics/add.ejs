<%- include('../layouts/admin', { title: 'Add Academic Content', style: '',
content: `
<div class="container-fluid" id="academicContentForm">
  ${locals.error ? `
  <div class="alert alert-danger alert-dismissible fade show" role="alert">
    ${error}
    <button
      type="button"
      class="btn-close"
      data-bs-dismiss="alert"
      aria-label="Close"
    ></button>
  </div>
  ` : ''} ${locals.success ? `
  <div class="alert alert-success alert-dismissible fade show" role="alert">
    ${success}
    <button
      type="button"
      class="btn-close"
      data-bs-dismiss="alert"
      aria-label="Close"
    ></button>
  </div>
  ` : ''}
  <div class="row">
    <div class="col-12">
      <div class="card">
        <div
          class="card-header d-flex justify-content-between align-items-center"
        >
          <h3 class="card-title">Add Academic Content</h3>
          <a href="/admin/academics" class="btn btn-secondary">
            <i class="fas fa-arrow-left me-1"></i>Back
          </a>
        </div>
        <div class="card-body">
          <form
            id="addContentForm"
            action="/admin/academics"
            method="POST"
            enctype="multipart/form-data"
          >
            <div class="row">
              <div class="col-md-8">
                <div class="mb-3">
                  <label for="contentTitle" class="form-label">Title</label>
                  <input
                    type="text"
                    class="form-control"
                    id="contentTitle"
                    name="title"
                    value="${locals.formData ? formData.title : ''}"
                    required
                  />
                </div>
                <div class="mb-3">
                  <label for="contentDescription" class="form-label"
                    >Description</label
                  >
                  <textarea
                    class="form-control"
                    id="contentDescription"
                    name="description"
                    rows="4"
                    required
                  >
${locals.formData ? formData.description : ''}</textarea
                  >
                </div>
              </div>
              <div class="col-md-4">
                <div class="mb-3">
                  <label for="contentImage" class="form-label">Image</label>
                  <input
                    type="file"
                    class="form-control"
                    id="contentImage"
                    name="image"
                    accept="image/*"
                    required
                  />
                  <small class="text-muted"
                    >Recommended size: 1200x800px. Max file size: 2MB</small
                  >
                </div>
                <div id="imagePreview" class="mt-3 d-none">
                  <img
                    src=""
                    alt="Preview"
                    class="img-fluid rounded"
                    style="max-height: 200px"
                  />
                </div>
              </div>
            </div>
            <div class="mt-4">
              <button type="submit" class="btn btn-primary">
                <i class="fas fa-save me-1"></i>Save Content
              </button>
              <a href="/admin/academics" class="btn btn-secondary ms-2">
                <i class="fas fa-times me-1"></i>Cancel
              </a>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
<script>
  // Image preview functionality
  document
    .getElementById("contentImage")
    .addEventListener("change", function (e) {
      const file = e.target.files[0];
      const previewContainer = document.getElementById("imagePreview");
      const previewImage = previewContainer.querySelector("img");

      // Reset preview
      previewContainer.classList.add("d-none");
      previewImage.src = "";

      if (file) {
        if (file.size > 2 * 1024 * 1024) {
          alert("Image file size should be less than 2MB");
          e.target.value = "";
          return;
        }

        if (!file.type.startsWith("image/")) {
          alert("Please upload a valid image file (JPG, PNG, GIF)");
          e.target.value = "";
          return;
        }

        const reader = new FileReader();
        reader.onload = function (event) {
          previewContainer.classList.remove("d-none");
          previewImage.src = event.target.result;
        };
        reader.readAsDataURL(file);
      }
    });
</script>
` }) %>
