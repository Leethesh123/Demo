<%- include('../layouts/admin', {
  title: 'Manage Teachers',
  style: '',
  script: '',
  content: `

<div class="container-fluid py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Teachers</h2>
    <a href="/admin/teachers/add" class="btn btn-primary">
      <i class="fas fa-plus"></i> Add New Teacher
    </a>
  </div>

  <div class="card">
    <div class="card-body">
      <div class="table-responsive">
        <table class="table table-hover">
          <thead>
            <tr>
              <th>Image</th>
              <th>Name</th>
              <th>Subject</th>
              <th>Email</th>
              <th>Qualifications</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            ${
              teachers && teachers.length > 0
                ? teachers.map(teacher => `
                  <tr>
                    <td>
                      ${
                        teacher.image
                          ? `<img src="${teacher.image}" alt="${teacher.name}" class="img-thumbnail" style="max-width: 50px" />`
                          : `<div class="text-center">-</div>`
                      }
                    </td>
                    <td>${teacher.name}</td>
                    <td>${teacher.subject}</td>
                    <td>${teacher.email}</td>
                    <td>${teacher.qualifications}</td>
                    <td>
                      ${
                        teacher.isActive
                          ? `<span class="badge bg-success">Active</span>`
                          : `<span class="badge bg-secondary">Inactive</span>`
                      }
                    </td>
                    <td>
                      <div class="btn-group">
                        <a href="/admin/teachers/edit/${teacher._id}" class="btn btn-sm btn-outline-primary">
                          <i class="fas fa-edit"></i>
                        </a>
                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="deleteTeacher('${teacher._id}')">
                          <i class="fas fa-trash"></i>
                        </button>
                      </div>
                    </td>
                  </tr>
                `).join('')
                : `
                  <tr>
                    <td colspan="7" class="text-center">No teachers found</td>
                  </tr>
                `
            }
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script>
  function deleteTeacher(teacherId) {
    if (confirm("Are you sure you want to delete this teacher?")) {
      fetch(\`/admin/teachers/delete/\${teacherId}\`, {
        method: "DELETE",
      })
        .then((response) => response.json())
        .then((data) => {
          if (data.success) {
            window.location.reload();
          } else {
            alert("Failed to delete teacher");
          }
        })
        .catch((error) => {
          console.error("Error:", error);
          alert("An error occurred while deleting the teacher");
        });
    }
  }
</script>

`
}) %>
