<%- include('../partials/header') %>

<div class="container my-5">
  <div class="row">
    <!-- Contact Information -->
    <div class="col-md-4 mb-4">
      <div class="card h-100">
        <div class="card-body">
          <h3 class="card-title mb-4">Contact Information</h3>
          <% if (contactInfo) { %>
          <div class="mb-3">
            <i class="fas fa-map-marker-alt me-2"></i>
            <strong>Address:</strong>
            <p class="ms-4 mb-3"><%= contactInfo.address %></p>
          </div>
          <div class="mb-3">
            <i class="fas fa-phone me-2"></i>
            <strong>Phone:</strong>
            <p class="ms-4 mb-3"><%= contactInfo.phone %></p>
          </div>
          <div class="mb-3">
            <i class="fas fa-envelope me-2"></i>
            <strong>Email:</strong>
            <p class="ms-4 mb-3"><%= contactInfo.email %></p>
          </div>
          <% } else { %>
          <p>Contact information will be available soon.</p>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Contact Form -->
    <div class="col-md-8 mb-4">
      <div class="card h-100">
        <div class="card-body">
          <h3 class="card-title mb-4">Send us a Message</h3>
          <form id="contactForm">
            <div class="mb-3">
              <label for="name" class="form-label">Name</label>
              <input
                type="text"
                class="form-control"
                id="name"
                name="name"
                required
              />
            </div>
            <div class="mb-3">
              <label for="email" class="form-label">Email</label>
              <input
                type="email"
                class="form-control"
                id="email"
                name="email"
                required
              />
            </div>
            <div class="mb-3">
              <label for="subject" class="form-label">Subject</label>
              <input
                type="text"
                class="form-control"
                id="subject"
                name="subject"
                required
              />
            </div>
            <div class="mb-3">
              <label for="message" class="form-label">Message</label>
              <textarea
                class="form-control"
                id="message"
                name="message"
                rows="5"
                required
              ></textarea>
            </div>
            <button type="submit" class="btn btn-primary">Send Message</button>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

