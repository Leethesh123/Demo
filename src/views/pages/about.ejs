<%- include('../partials/header') %>
<div class="container my-5">
  <% if (about) { %>
  <div class="row align-items-center mb-5">
    <div class="col-lg-6">
      <h1 class="display-4 mb-4">About Our School</h1>
      <% if (about.image) { %>
      <img
        src="<%= about.image %>"
        alt="School Image"
        class="img-fluid rounded shadow-lg mb-4"
        style="max-height: 200px; width: 100%; object-fit: cover"
      />
      <% } %>
    </div>
    <div class="col-lg-6">
      <div class="card shadow-sm">
        <div class="card-body">
          <h2 class="h4 mb-3"><%= about.missionTitle %></h2>
          <p class="text-muted"><%= about.mission %></p>
        </div>
      </div>
    </div>
  </div>

  <div class="row mb-5">
    <div class="col-lg-6">
      <div class="card shadow-sm h-100">
        <div class="card-body">
          <h2 class="h4 mb-3"><%= about.visionTitle %></h2>
          <p class="text-muted"><%= about.vision %></p>
        </div>
      </div>
    </div>
    <div class="col-lg-6">
      <div class="card shadow-sm h-100">
        <div class="card-body">
          <h2 class="h4 mb-3"><%= about.historyTitle %></h2>
          <p class="text-muted"><%= about.history %></p>
        </div>
      </div>
    </div>
  </div>
  <% } else { %>
  <div class="alert alert-info">
    No about content has been added yet. Please add content through the admin
    panel.
  </div>
  <% } %>

  <!-- Testimonials Section -->
  <% if (testimonials && testimonials.length > 0) { %>
  <div class="row mt-5">
    <div class="col-12">
      <h2 class="text-center mb-4">What People Say About Us</h2>
      <div class="row g-4">
        <% testimonials.forEach(testimonial => { %>
        <div class="col-md-4">
          <div class="card h-100 shadow-sm">
            <div class="card-body">
              <div class="d-flex align-items-center mb-3">
                <% if (testimonial.image) { %>
                <img
                  src="<%= testimonial.image %>"
                  alt="<%= testimonial.personName %>"
                  class="rounded-circle me-3"
                  style="width: 60px; height: 60px; object-fit: cover"
                />
                <% } else { %>
                <div
                  class="bg-secondary rounded-circle me-3"
                  style="width: 60px; height: 60px"
                ></div>
                <% } %>
                <div>
                  <h5 class="card-title mb-0"><%= testimonial.personName %></h5>
                  <p class="text-muted mb-0"><%= testimonial.designation %></p>
                </div>
              </div>
              <p class="card-text">
                <% let messageWords = testimonial.message.split(' ');
                messageWords = messageWords.map(word => { if
                (testimonial.highlightedWords.includes(word)) { return
                `<strong>${word}</strong>`; } return word; }); %> <%-
                messageWords.join(' ') %>
              </p>
            </div>
          </div>
        </div>
        <% }); %>
      </div>
    </div>
  </div>
  <% } %>
</div>
<%- include('../partials/footer') %>
